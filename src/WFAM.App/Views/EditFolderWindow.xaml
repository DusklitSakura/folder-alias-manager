<ui:FluentWindow x:Class="WFAM.App.Views.EditFolderWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:WFAM.App.ViewModels"
                 xmlns:loc="clr-namespace:WFAM.App.Helpers"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:EditFolderViewModel}"
                 Title="{loc:Tr Edit.Title}"
                 Width="520" Height="420"
                 MinWidth="460" MinHeight="380"
                 ResizeMode="CanResize"
                 ShowInTaskbar="True"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{loc:Tr Edit.Title}"
                     ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="FolderLink24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="20,8,20,8">
            <!-- 编辑表单 -->
            <Grid Visibility="{Binding HasItem, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 头部：图标 + 名称 + 路径 -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Width="48" Height="48"
                            CornerRadius="6"
                            Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                            Margin="0,0,12,0">
                        <Image Source="{Binding Item.SelectedIcon.Image}"
                               Width="36" Height="36"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <ui:TextBlock Text="{Binding Item.Name}"
                                      FontTypography="BodyStrong" />
                        <ui:TextBlock Text="{Binding Item.Path}"
                                      FontTypography="Caption"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                      TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <!-- 别名 -->
                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                    <ui:TextBlock Text="{loc:Tr Edit.Alias}" Margin="0,0,0,4" />
                    <ui:TextBox Text="{Binding Item.Alias, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="{loc:Tr Folders.AliasPlaceholder}" />
                </StackPanel>

                <!-- 图标 -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <ui:TextBlock Text="{loc:Tr Edit.Icon}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Item.AvailableIcons}"
                                  SelectedItem="{Binding Item.SelectedIcon, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding Image}"
                                               Width="20" Height="20"
                                               Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding DisplayName}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <ui:Button Grid.Column="1"
                               Margin="8,20,0,0"
                               Icon="{ui:SymbolIcon ImageAdd24}"
                               Appearance="Secondary"
                               ToolTip="{loc:Tr Folders.Tip.PickIcon}"
                               Command="{Binding PickCustomIconCommand}" />
                </Grid>

                <!-- 背景 -->
                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <ui:TextBlock Text="{loc:Tr Background.Label}" Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding Item.BackgroundImage, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="{loc:Tr Background.Placeholder}" />
                    </StackPanel>
                    <ui:Button Grid.Column="1"
                               Margin="8,20,0,0"
                               Icon="{ui:SymbolIcon ImageMultiple24}"
                               Appearance="Secondary"
                               ToolTip="{loc:Tr Background.Tip.Pick}"
                               Command="{Binding PickBackgroundCommand}" />
                    <ui:Button Grid.Column="2"
                               Margin="4,20,0,0"
                               Icon="{ui:SymbolIcon ImageOff24}"
                               Appearance="Secondary"
                               ToolTip="{loc:Tr Background.Tip.Clear}"
                               Command="{Binding ClearBackgroundCommand}" />
                </Grid>
            </Grid>

            <!-- 加载/保存遮罩 -->
            <Border Background="#80000000"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:ProgressRing IsIndeterminate="True" Width="40" Height="40" />
                    <ui:TextBlock Text="{Binding BusyMessage}"
                                  Foreground="White"
                                  Margin="0,8,0,0"
                                  HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="20,0,20,16">
            <ui:Button Content="{loc:Tr Edit.RestoreDefault}"
                       Icon="{ui:SymbolIcon ArrowReset24}"
                       Appearance="Secondary"
                       Command="{Binding RestoreDefaultCommand}"
                       Margin="0,0,8,0" />
            <ui:Button Content="{loc:Tr Common.Cancel}"
                       Appearance="Secondary"
                       Click="OnCancelClick"
                       Margin="0,0,8,0" />
            <ui:Button Content="{loc:Tr Folders.Save}"
                       Appearance="Primary"
                       Icon="{ui:SymbolIcon Save24}"
                       Click="OnSaveClick"
                       IsEnabled="{Binding HasItem}" />
        </StackPanel>

        <!-- Snackbar 容器 -->
        <ui:SnackbarPresenter x:Name="SnackbarPresenter"
                              Grid.Row="1"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom"
                              Margin="0,0,16,16" />
    </Grid>
</ui:FluentWindow>

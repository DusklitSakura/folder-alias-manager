<Page x:Class="WFAM.App.Views.Pages.HistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:WFAM.App.ViewModels"
      xmlns:loc="clr-namespace:WFAM.App.Helpers"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:HistoryViewModel}"
      Title="{loc:Tr History.Title}"
      Background="Transparent">

    <Grid Margin="36,18,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <ui:TextBlock Text="{loc:Tr History.Heading}"
                              FontTypography="Subtitle" Margin="0,0,0,4" />
                <ui:TextBlock Text="{loc:Tr History.Description}"
                              FontTypography="Caption"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <ui:Button Grid.Column="1"
                       Content="{loc:Tr History.Clear}"
                       Icon="{ui:SymbolIcon Eraser24}"
                       Appearance="Secondary"
                       Command="{Binding ClearCommand}"
                       VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="1"
                Background="{DynamicResource ControlOnImageFillColorDefaultBrush}"
                CornerRadius="8">
            <Grid>
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVis}}">
                    <ui:SymbolIcon Symbol="History24"
                                   FontSize="48"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <ui:TextBlock Text="{loc:Tr History.Empty}"
                                  FontTypography="Subtitle"
                                  HorizontalAlignment="Center"
                                  Margin="0,8,0,0" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Items}" Padding="12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:HistoryItemViewModel}">
                                <ui:Card Margin="0,0,0,8" Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:TextBlock Text="{Binding FolderName}"
                                                              FontTypography="BodyStrong" />
                                                <ui:TextBlock Text="{Binding ActionText}"
                                                              Margin="10,0,0,0"
                                                              FontTypography="Caption"
                                                              Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                <ui:TextBlock Text="{Binding TimestampText}"
                                                              Margin="10,0,0,0"
                                                              FontTypography="Caption"
                                                              Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>
                                            <ui:TextBlock Text="{Binding FolderPath}"
                                                          FontTypography="Caption"
                                                          Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                          TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <ui:TextBlock Text="{loc:Tr History.Before}"
                                                              FontTypography="Caption"
                                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <ui:TextBlock Text="{Binding BeforeText}"
                                                              FontTypography="Caption" Margin="6,0,0,0"
                                                              TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:TextBlock Text="{loc:Tr History.After}"
                                                              FontTypography="Caption"
                                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <ui:TextBlock Text="{Binding AfterText}"
                                                              FontTypography="Caption" Margin="6,0,0,0"
                                                              TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <ui:Button Content="{loc:Tr History.Restore}"
                                                       Icon="{ui:SymbolIcon ArrowUndo24}"
                                                       Appearance="Primary"
                                                       Command="{Binding DataContext.RestoreCommand,
                                                                         RelativeSource={RelativeSource AncestorType=Page}}"
                                                       CommandParameter="{Binding}"
                                                       Margin="0,0,6,0" />
                                            <ui:Button Icon="{ui:SymbolIcon Delete24}"
                                                       Appearance="Secondary"
                                                       ToolTip="{loc:Tr History.Remove}"
                                                       Command="{Binding DataContext.RemoveCommand,
                                                                         RelativeSource={RelativeSource AncestorType=Page}}"
                                                       CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Background="#80000000"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>

<Page x:Class="WFAM.App.Views.Pages.UsbDrivesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:WFAM.App.ViewModels"
      xmlns:loc="clr-namespace:WFAM.App.Helpers"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:UsbDrivesViewModel}"
      Title="{loc:Tr Drives.Title}"
      Background="Transparent">

    <Grid Margin="36,18,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部说明 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <ui:TextBlock Text="{loc:Tr Drives.Heading}"
                          FontTypography="Subtitle"
                          Margin="0,0,0,4" />
            <ui:TextBlock Text="{loc:Tr Drives.Description}"
                          FontTypography="Caption"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- 顶部操作条 -->
        <ui:Card Grid.Row="1" Padding="20" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Warning24"
                                   FontSize="24"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   Margin="0,0,12,0" />
                    <StackPanel>
                        <ui:TextBlock Text="{loc:Tr Drives.Hint.Title}"
                                      FontTypography="BodyStrong" />
                        <ui:TextBlock Text="{loc:Tr Drives.Hint.Subtitle}"
                                      FontTypography="Caption"
                                      TextWrapping="Wrap"
                                      MaxWidth="700"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                    <ui:Button Appearance="Primary"
                               Icon="{ui:SymbolIcon ArrowSync24}"
                               Content="{loc:Tr Drives.Refresh}"
                               Command="{Binding RefreshCommand}"
                               Margin="0,0,0,8" />
                    <ui:ToggleSwitch Content="{loc:Tr Drives.IncludeFixed}"
                                     IsChecked="{Binding IncludeFixedDrives, Mode=TwoWay}" />
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- 驱动器列表 -->
        <Border Grid.Row="2"
                Background="{DynamicResource ControlOnImageFillColorDefaultBrush}"
                CornerRadius="8">
            <Grid>
                <!-- 空状态 -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasDrives, Converter={StaticResource InverseBoolToVis}}">
                    <ui:SymbolIcon Symbol="UsbStick24"
                                   FontSize="48"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <ui:TextBlock Text="{loc:Tr Drives.Empty.Title}"
                                  FontTypography="Subtitle"
                                  HorizontalAlignment="Center"
                                  Margin="0,8,0,0" />
                    <ui:TextBlock Text="{loc:Tr Drives.Empty.Description}"
                                  FontTypography="Caption"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  HorizontalAlignment="Center" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasDrives, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Drives}" Padding="12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DriveItemViewModel}">
                                <ui:Card Margin="0,0,0,8" Padding="14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- 上排：图标预览 + 盘符/容量 -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    Width="48" Height="48"
                                                    CornerRadius="6"
                                                    Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                                    Margin="0,0,14,0">
                                                <Image Source="{Binding SelectedIcon.Image}"
                                                       Width="36" Height="36"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <ui:TextBlock Text="{Binding DisplayName}"
                                                              FontTypography="BodyStrong" />
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:TextBlock Text="{Binding DriveTypeText}"
                                                                  FontTypography="Caption"
                                                                  Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                  Margin="0,0,12,0" />
                                                    <ui:TextBlock Text="{Binding CapacityText}"
                                                                  FontTypography="Caption"
                                                                  Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <!-- 下排：label / 图标 / 操作按钮 -->
                                        <Grid Grid.Row="1" Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <ui:TextBox Grid.Column="0"
                                                        VerticalAlignment="Center"
                                                        Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                                        PlaceholderText="{loc:Tr Drives.LabelPlaceholder}" />

                                            <ComboBox Grid.Column="1"
                                                      Margin="10,0,0,0"
                                                      VerticalAlignment="Center"
                                                      ItemsSource="{Binding AvailableIcons}"
                                                      SelectedItem="{Binding SelectedIcon, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Image Source="{Binding Image}"
                                                                   Width="20" Height="20"
                                                                   Margin="0,0,8,0" />
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                            <StackPanel Grid.Column="2"
                                                        Orientation="Horizontal"
                                                        Margin="10,0,0,0"
                                                        VerticalAlignment="Center">
                                                <ui:Button Icon="{ui:SymbolIcon ImageAdd24}"
                                                           Appearance="Secondary"
                                                           ToolTip="{loc:Tr Drives.Tip.PickIcon}"
                                                           Command="{Binding DataContext.PickCustomIconCommand,
                                                                             RelativeSource={RelativeSource AncestorType=Page}}"
                                                           CommandParameter="{Binding}"
                                                           Margin="0,0,4,0" />
                                                <ui:Button Icon="{ui:SymbolIcon ImageMultiple24}"
                                                           Appearance="Secondary"
                                                           ToolTip="{loc:Tr Background.Tip.Pick}"
                                                           Command="{Binding DataContext.PickBackgroundCommand,
                                                                             RelativeSource={RelativeSource AncestorType=Page}}"
                                                           CommandParameter="{Binding}"
                                                           Margin="0,0,4,0" />
                                                <ui:Button Icon="{ui:SymbolIcon ImageOff24}"
                                                           Appearance="Secondary"
                                                           ToolTip="{loc:Tr Background.Tip.Clear}"
                                                           Command="{Binding DataContext.ClearBackgroundCommand,
                                                                             RelativeSource={RelativeSource AncestorType=Page}}"
                                                           CommandParameter="{Binding}"
                                                           IsEnabled="{Binding HasBackground}"
                                                           Margin="0,0,4,0" />

                                        <!-- 背景预览 -->
                                        <StackPanel Grid.Row="2"
                                                    Orientation="Horizontal"
                                                    Margin="0,8,0,0"
                                                    Visibility="{Binding HasBackground, Converter={StaticResource BoolToVis}}">
                                            <ui:SymbolIcon Symbol="ImageMultiple24"
                                                           FontSize="14"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0" />
                                            <ui:TextBlock Text="{loc:Tr Background.Label}"
                                                          FontTypography="Caption"
                                                          Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,4,0" />
                                            <ui:TextBlock Text="{Binding BackgroundDisplayName}"
                                                          FontTypography="Caption"
                                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                          TextTrimming="CharacterEllipsis"
                                                          VerticalAlignment="Center" />
                                        </StackPanel>
                                                <ui:Button Icon="{ui:SymbolIcon ArrowReset24}"
                                                           Appearance="Secondary"
                                                           ToolTip="{loc:Tr Drives.Tip.RestoreDefault}"
                                                           Command="{Binding DataContext.RestoreCommand,
                                                                             RelativeSource={RelativeSource AncestorType=Page}}"
                                                           CommandParameter="{Binding}"
                                                           Margin="0,0,4,0" />
                                                <ui:Button Icon="{ui:SymbolIcon FolderOpen24}"
                                                           Appearance="Secondary"
                                                           ToolTip="{loc:Tr Drives.Tip.OpenInExplorer}"
                                                           Command="{Binding DataContext.OpenInExplorerCommand,
                                                                             RelativeSource={RelativeSource AncestorType=Page}}"
                                                           CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 加载遮罩 -->
                <Border Background="#80000000"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <ui:ProgressRing IsIndeterminate="True"
                                         Width="56" Height="56" />
                        <ui:TextBlock Text="{Binding BusyMessage}"
                                      Foreground="White"
                                      Margin="0,12,0,0"
                                      HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 底部操作栏 -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="{loc:Tr Drives.Save}"
                           Icon="{ui:SymbolIcon Save24}"
                           Appearance="Primary"
                           Command="{Binding SaveCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>

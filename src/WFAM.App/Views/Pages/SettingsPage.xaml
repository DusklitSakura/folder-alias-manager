<Page x:Class="WFAM.App.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:WFAM.App.ViewModels"
      xmlns:loc="clr-namespace:WFAM.App.Helpers"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
      Title="{loc:Tr Settings.Title}"
      Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,18,36,24">

            <!-- 外观 -->
            <ui:TextBlock Text="{loc:Tr Settings.Group.Appearance}"
                          FontTypography="Subtitle" Margin="0,0,0,12" />

            <ui:CardControl Margin="0,0,0,24">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="{loc:Tr Settings.Theme}" FontTypography="BodyStrong" />
                        <ui:TextBlock Text="{loc:Tr Settings.Theme.Description}"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox ItemsSource="{Binding AvailableThemes}"
                          SelectedItem="{Binding CurrentTheme, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName"
                          Width="220" />
            </ui:CardControl>

            <!-- 语言 -->
            <ui:TextBlock Text="{loc:Tr Settings.Group.Language}"
                          FontTypography="Subtitle" Margin="0,0,0,12" />

            <ui:CardControl Margin="0,0,0,24">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="{loc:Tr Settings.Language}" FontTypography="BodyStrong" />
                        <ui:TextBlock Text="{loc:Tr Settings.Language.Description}"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox ItemsSource="{Binding AvailableLanguages}"
                          SelectedItem="{Binding CurrentLanguage, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName"
                          Width="200" />
            </ui:CardControl>

            <!-- 系统集成 -->
            <ui:TextBlock Text="{loc:Tr Settings.Group.Integration}"
                          FontTypography="Subtitle" Margin="0,0,0,12" />

            <ui:CardControl Margin="0,0,0,12">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="{loc:Tr Settings.ContextMenu}" FontTypography="BodyStrong" />
                        <ui:TextBlock Text="{loc:Tr Settings.ContextMenu.Description}"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <ui:SymbolIcon Symbol="Info16" Margin="0,0,6,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <ui:TextBlock VerticalAlignment="Center"
                                          FontTypography="Caption"
                                          Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                          Text="{loc:Tr Settings.ContextMenu.On}"
                                          Visibility="{Binding IsContextMenuRegistered,
                                                               Converter={StaticResource BoolToVis}}" />
                            <ui:TextBlock VerticalAlignment="Center"
                                          FontTypography="Caption"
                                          Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                          Text="{loc:Tr Settings.ContextMenu.Off}"
                                          Visibility="{Binding IsContextMenuRegistered,
                                                               Converter={StaticResource InverseBoolToVis}}" />
                        </StackPanel>
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="{loc:Tr Settings.ContextMenu.Register}"
                               Appearance="Primary"
                               Icon="{ui:SymbolIcon Add24}"
                               Command="{Binding RegisterContextMenuCommand}"
                               Margin="0,0,8,0" />
                    <ui:Button Content="{loc:Tr Settings.ContextMenu.Unregister}"
                               Appearance="Secondary"
                               Icon="{ui:SymbolIcon Delete24}"
                               Command="{Binding UnregisterContextMenuCommand}" />
                </StackPanel>
            </ui:CardControl>

            <!-- 更新 -->
            <ui:TextBlock Text="{loc:Tr Settings.Group.Update}"
                          FontTypography="Subtitle" Margin="0,12,0,12" />

            <ui:CardControl Margin="0,0,0,12">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="{loc:Tr Settings.Update}" FontTypography="BodyStrong" />
                        <ui:TextBlock Text="{loc:Tr Settings.Update.Description}"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <ui:TextBlock FontTypography="Caption"
                                          Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                          Text="{loc:Tr Settings.Update.CurrentVersion}" />
                            <ui:TextBlock FontTypography="Caption"
                                          Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                          Margin="4,0,0,0"
                                          Text="{Binding CurrentVersionText, Mode=OneWay}" />
                        </StackPanel>
                        <ui:TextBlock Text="{Binding UpdateStatusText, Mode=OneWay}"
                                      FontTypography="Caption"
                                      Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                      TextWrapping="Wrap"
                                      Margin="0,4,0,0" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Vertical">
                    <ui:ToggleSwitch Content="{loc:Tr Settings.Update.Auto}"
                                     IsChecked="{Binding AutoCheckUpdate, Mode=TwoWay}"
                                     Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="{loc:Tr Update.CheckNow}"
                                   Appearance="Primary"
                                   Icon="{ui:SymbolIcon ArrowDownload24}"
                                   Command="{Binding CheckUpdateCommand}"
                                   IsEnabled="{Binding CanCheckUpdate, Mode=OneWay}"
                                   Margin="0,0,8,0" />
                        <ui:Button Content="{loc:Tr Update.UpdateNow}"
                                   Appearance="Secondary"
                                   Icon="{ui:SymbolIcon ArrowSync24}"
                                   Command="{Binding UpdateNowCommand}"
                                   Visibility="{Binding HasUpdateAvailable, Converter={StaticResource BoolToVis}}"
                                   Margin="0,0,8,0" />
                        <ui:Button Content="{loc:Tr Update.SkipThisVersion}"
                                   Appearance="Secondary"
                                   Command="{Binding SkipThisVersionCommand}"
                                   Visibility="{Binding HasUpdateAvailable, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </StackPanel>
            </ui:CardControl>

            <!-- 关于 -->
            <ui:TextBlock Text="{loc:Tr About.Title}"
                          FontTypography="Subtitle" Margin="0,12,0,12" />

            <ui:Card Padding="22" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ui:SymbolIcon Symbol="FolderLink24" FontSize="30" Margin="0,0,12,0" />
                        <StackPanel VerticalAlignment="Center">
                            <ui:TextBlock Text="{loc:Tr About.AppName}" FontTypography="Title" />
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock FontTypography="Caption"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                              Text="{loc:Tr About.VersionFormat}" />
                                <ui:TextBlock FontTypography="Caption"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                              Margin="4,0,0,0"
                                              Text="{Binding About.Version, Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <Separator Margin="0,12" />
                    <ui:TextBlock Text="{loc:Tr About.Description}" TextWrapping="Wrap" />

                    <Separator Margin="0,12" />
                    <ui:TextBlock Text="{loc:Tr About.Tech}" FontTypography="BodyStrong" Margin="0,0,0,6" />
                    <ui:TextBlock Text="{loc:Tr About.Tech.Body}" TextWrapping="Wrap"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <Separator Margin="0,12" />
                    <WrapPanel Orientation="Horizontal">
                        <ui:HyperlinkButton Content="{loc:Tr About.OpenWpfUi}"
                                            Icon="{ui:SymbolIcon Link24}"
                                            Command="{Binding About.OpenLinkCommand}"
                                            CommandParameter="{Binding About.WpfUiUrl}"
                                            Margin="0,0,0,4" />
                    </WrapPanel>
                </StackPanel>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</Page>

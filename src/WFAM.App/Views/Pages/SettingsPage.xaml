<Page x:Class="WFAM.App.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:WFAM.App.ViewModels"
      xmlns:loc="clr-namespace:WFAM.App.Helpers"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
      Title="{loc:Tr Settings.Title}"
      Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,16,28,20">

            <!-- ========== 顶部：页头 ========== -->
            <ui:TextBlock Text="{loc:Tr Settings.Title}"
                          FontTypography="TitleLarge" Margin="0,0,0,4" />
            <ui:TextBlock Text="{loc:Tr Settings.Subtitle}"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          TextWrapping="Wrap"
                          Margin="0,0,0,18" />

            <!-- ========== 中部双列 ========== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="320" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <!-- 左列：外观 / 语言 / 更新 -->
                <StackPanel Grid.Column="0">

                    <!-- 外观 -->
                    <ui:TextBlock Text="{loc:Tr Settings.Group.Appearance}"
                                  FontTypography="Subtitle" Margin="0,0,0,10" />

                    <ui:CardControl Margin="0,0,0,18">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Text="{loc:Tr Settings.Theme}" FontTypography="BodyStrong" />
                                <ui:TextBlock Text="{loc:Tr Settings.Theme.Description}"
                                              FontTypography="Caption"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ComboBox ItemsSource="{Binding AvailableThemes}"
                                  SelectedItem="{Binding CurrentTheme, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  Width="180" />
                    </ui:CardControl>

                    <!-- 语言 -->
                    <ui:TextBlock Text="{loc:Tr Settings.Group.Language}"
                                  FontTypography="Subtitle" Margin="0,0,0,10" />

                    <ui:CardControl Margin="0,0,0,18">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Text="{loc:Tr Settings.Language}" FontTypography="BodyStrong" />
                                <ui:TextBlock Text="{loc:Tr Settings.Language.Description}"
                                              FontTypography="Caption"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ComboBox ItemsSource="{Binding AvailableLanguages}"
                                  SelectedItem="{Binding CurrentLanguage, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  Width="170" />
                    </ui:CardControl>

                    <!-- 更新 -->
                    <ui:TextBlock Text="{loc:Tr Settings.Group.Update}"
                                  FontTypography="Subtitle" Margin="0,0,0,10" />

                    <ui:CardControl Margin="0,0,0,8">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ui:TextBlock Text="{loc:Tr Settings.Update}" FontTypography="BodyStrong" />
                                    <ui:TextBlock FontTypography="Caption"
                                                  Margin="8,0,0,0"
                                                  VerticalAlignment="Center"
                                                  Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                  Text="{Binding CurrentVersionText, Mode=OneWay}" />
                                </StackPanel>
                                <ui:TextBlock Text="{loc:Tr Settings.Update.Description}"
                                              FontTypography="Caption"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                              TextWrapping="Wrap" />
                                <ui:TextBlock Text="{Binding UpdateStatusText, Mode=OneWay}"
                                              FontTypography="Caption"
                                              Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                              TextWrapping="Wrap"
                                              Margin="0,4,0,0" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch IsChecked="{Binding AutoCheckUpdate, Mode=TwoWay}" />
                    </ui:CardControl>

                    <WrapPanel Orientation="Horizontal">
                        <ui:Button Content="{loc:Tr Update.CheckNow}"
                                   Appearance="Primary"
                                   Icon="{ui:SymbolIcon ArrowDownload24}"
                                   Command="{Binding CheckUpdateCommand}"
                                   IsEnabled="{Binding CanCheckUpdate, Mode=OneWay}"
                                   Margin="0,0,8,8" />
                        <ui:Button Content="{loc:Tr Update.UpdateNow}"
                                   Appearance="Secondary"
                                   Icon="{ui:SymbolIcon ArrowSync24}"
                                   Command="{Binding UpdateNowCommand}"
                                   Visibility="{Binding HasUpdateAvailable, Converter={StaticResource BoolToVis}}"
                                   Margin="0,0,8,8" />
                        <ui:Button Content="{loc:Tr Update.SkipThisVersion}"
                                   Appearance="Secondary"
                                   Command="{Binding SkipThisVersionCommand}"
                                   Visibility="{Binding HasUpdateAvailable, Converter={StaticResource BoolToVis}}"
                                   Margin="0,0,0,8" />
                    </WrapPanel>
                </StackPanel>

                <!-- 右列：系统集成 -->
                <StackPanel Grid.Column="2">

                    <ui:TextBlock Text="{loc:Tr Settings.Group.Integration}"
                                  FontTypography="Subtitle" Margin="0,0,0,10" />

                    <ui:CardControl Margin="0,0,0,8">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Text="{loc:Tr Settings.ContextMenu}" FontTypography="BodyStrong" />
                                <ui:TextBlock Text="{loc:Tr Settings.ContextMenu.Description}"
                                              FontTypography="Caption"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                              TextWrapping="Wrap" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch IsChecked="{Binding IsContextMenuRegistered, Mode=TwoWay}" />
                    </ui:CardControl>

                    <ui:CardControl Margin="0,0,0,8">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Text="{loc:Tr Settings.IconCopy.Title}" FontTypography="BodyStrong" />
                                <ui:TextBlock Text="{loc:Tr Settings.IconCopy.Description}"
                                              FontTypography="Caption"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                              TextWrapping="Wrap" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch IsChecked="{Binding CopyIconToFolder, Mode=TwoWay}" />
                    </ui:CardControl>

                    <ui:CardControl>
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock Text="{loc:Tr Settings.ExplorerBg.Title}" FontTypography="BodyStrong" />
                                <ui:TextBlock Text="{loc:Tr Settings.ExplorerBg.Description}"
                                              FontTypography="Caption"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                              TextWrapping="Wrap" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch IsChecked="{Binding ExplorerBgInstalled, Mode=TwoWay}"
                                         IsEnabled="{Binding CanToggleExplorerBg}" />
                    </ui:CardControl>
                </StackPanel>
            </Grid>

            <!-- ========== 关于（整行，最下方） ========== -->
            <ui:TextBlock Text="{loc:Tr About.Title}"
                          FontTypography="Subtitle" Margin="0,18,0,10" />

            <ui:Card Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="FolderLink24" FontSize="28" Margin="0,0,12,0"
                                       VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <ui:TextBlock Text="{loc:Tr About.AppName}" FontTypography="Title" />
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock FontTypography="Caption"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                              Text="{loc:Tr About.VersionFormat}" />
                                <ui:TextBlock FontTypography="Caption"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                              Margin="4,0,0,0"
                                              Text="{Binding About.Version, Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <ui:TextBlock Text="{loc:Tr About.Description}"
                                  TextWrapping="Wrap"
                                  Margin="0,12,0,0" />

                    <ui:HyperlinkButton Content="{loc:Tr About.OpenWpfUi}"
                                        Icon="{ui:SymbolIcon Link24}"
                                        Command="{Binding About.OpenLinkCommand}"
                                        CommandParameter="{Binding About.WpfUiUrl}"
                                        Margin="0,8,0,0"
                                        Padding="0" />
                </StackPanel>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</Page>

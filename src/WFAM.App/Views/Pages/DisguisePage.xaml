<Page x:Class="WFAM.App.Views.Pages.DisguisePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:WFAM.App.ViewModels"
      xmlns:helpers="clr-namespace:WFAM.App.Helpers"
      xmlns:loc="clr-namespace:WFAM.App.Helpers"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:DisguiseViewModel}"
      Title="{loc:Tr Disguise.Title}"
      Background="Transparent"
      AllowDrop="True"
      helpers:DragDropHelper.DropDisguiseFolders="True">

    <Grid Margin="36,18,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部说明 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <ui:TextBlock Text="{loc:Tr Disguise.Heading}"
                          FontTypography="Subtitle"
                          Margin="0,0,0,4" />
            <ui:TextBlock Text="{loc:Tr Disguise.Description}"
                          FontTypography="Caption"
                          TextWrapping="Wrap"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- 警告条：不可逆性提示 -->
        <ui:InfoBar Grid.Row="1"
                    Margin="0,0,0,12"
                    Severity="Warning"
                    IsClosable="False"
                    IsOpen="True"
                    Title="{loc:Tr Disguise.Warning.Title}"
                    Message="{loc:Tr Disguise.Warning.Message}" />

        <!-- 拖放区 + 默认预设选择 + 操作按钮 -->
        <ui:Card Grid.Row="2" Padding="20" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        AllowDrop="True"
                        helpers:DragDropHelper.DropDisguiseFolders="True"
                        BorderThickness="2"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        Background="{DynamicResource SubtleFillColorTransparentBrush}"
                        CornerRadius="8"
                        Padding="20"
                        MinHeight="96">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="ArrowDownload24"
                                       FontSize="32"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       Margin="0,0,12,0" />
                        <StackPanel>
                            <ui:TextBlock Text="{loc:Tr Disguise.DropPrimary}"
                                          FontTypography="BodyStrong" />
                            <ui:TextBlock Text="{loc:Tr Disguise.DropSecondary}"
                                          FontTypography="Caption"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1"
                            Orientation="Vertical"
                            VerticalAlignment="Center"
                            Margin="20,0,0,0">
                    <ui:Button Appearance="Primary"
                               Icon="{ui:SymbolIcon FolderAdd24}"
                               Content="{loc:Tr Folders.Import}"
                               Command="{Binding PickAndAddCommand}"
                               Margin="0,0,0,8" />
                    <ui:TextBlock Text="{loc:Tr Disguise.DefaultPreset}"
                                  FontTypography="Caption"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox MinWidth="220"
                              Margin="0,4,0,0"
                              ItemsSource="{Binding Presets}"
                              SelectedItem="{Binding SelectedPreset, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="{Binding Symbol}"
                                                   FontSize="16"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding DisplayName}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- 列表 -->
        <Border Grid.Row="3"
                Background="{DynamicResource ControlOnImageFillColorDefaultBrush}"
                CornerRadius="8">
            <Grid>
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasFolders, Converter={StaticResource InverseBoolToVis}}">
                    <ui:SymbolIcon Symbol="HatGraduation24"
                                   FontSize="48"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <ui:TextBlock Text="{loc:Tr Disguise.Empty.Title}"
                                  FontTypography="Subtitle"
                                  HorizontalAlignment="Center"
                                  Margin="0,8,0,0" />
                    <ui:TextBlock Text="{loc:Tr Disguise.Empty.Description}"
                                  FontTypography="Caption"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  HorizontalAlignment="Center" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasFolders, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Folders}" Padding="12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DisguiseItemViewModel}">
                                <ui:Card Margin="0,0,0,8" Padding="14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- 名称 + 状态 -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    Width="44" Height="44"
                                                    CornerRadius="6"
                                                    Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                                    Margin="0,0,14,0">
                                                <ui:SymbolIcon Symbol="HatGraduation24"
                                                               FontSize="22"
                                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <ui:TextBlock Text="{Binding Name}"
                                                              FontTypography="BodyStrong" />
                                                <ui:TextBlock Text="{Binding Path}"
                                                              FontTypography="Caption"
                                                              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                              TextTrimming="CharacterEllipsis" />
                                                <ui:TextBlock Text="{Binding StatusText}"
                                                              FontTypography="Caption"
                                                              Margin="0,2,0,0"
                                                              Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- 预设 + 操作按钮 -->
                                        <Grid Grid.Row="1" Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <ComboBox Grid.Column="0"
                                                      VerticalAlignment="Center"
                                                      ItemsSource="{Binding DataContext.Presets,
                                                                            RelativeSource={RelativeSource AncestorType=Page}}"
                                                      SelectedItem="{Binding SelectedPreset, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="{Binding Symbol}"
                                                                           FontSize="16"
                                                                           Margin="0,0,8,0"
                                                                           VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        Margin="10,0,0,0"
                                                        VerticalAlignment="Center">
                                                <ui:Button Content="{loc:Tr Disguise.Apply}"
                                                           Icon="{ui:SymbolIcon HatGraduation24}"
                                                           Appearance="Primary"
                                                           Command="{Binding DataContext.DisguiseCommand,
                                                                             RelativeSource={RelativeSource AncestorType=Page}}"
                                                           CommandParameter="{Binding}"
                                                           Margin="0,0,4,0" />
                                                <ui:Button Content="{loc:Tr Disguise.Restore}"
                                                           Icon="{ui:SymbolIcon ArrowReset24}"
                                                           Appearance="Secondary"
                                                           IsEnabled="{Binding IsDisguised}"
                                                           Command="{Binding DataContext.RestoreCommand,
                                                                             RelativeSource={RelativeSource AncestorType=Page}}"
                                                           CommandParameter="{Binding}"
                                                           Margin="0,0,4,0" />
                                                <ui:Button Icon="{ui:SymbolIcon FolderOpen24}"
                                                           Appearance="Secondary"
                                                           ToolTip="{loc:Tr Folders.Tip.OpenInExplorer}"
                                                           Command="{Binding DataContext.OpenInExplorerCommand,
                                                                             RelativeSource={RelativeSource AncestorType=Page}}"
                                                           CommandParameter="{Binding}"
                                                           Margin="0,0,4,0" />
                                                <ui:Button Icon="{ui:SymbolIcon Delete24}"
                                                           Appearance="Danger"
                                                           ToolTip="{loc:Tr Folders.Tip.Remove}"
                                                           Command="{Binding DataContext.RemoveCommand,
                                                                             RelativeSource={RelativeSource AncestorType=Page}}"
                                                           CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Background="#80000000"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <ui:ProgressRing IsIndeterminate="True"
                                         Width="56" Height="56" />
                        <ui:TextBlock Text="{Binding BusyMessage}"
                                      Foreground="White"
                                      Margin="0,12,0,0"
                                      HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 底部操作栏 -->
        <Grid Grid.Row="4" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="{loc:Tr Folders.Clear}"
                           Icon="{ui:SymbolIcon Eraser24}"
                           Appearance="Secondary"
                           Command="{Binding ClearCommand}"
                           Margin="0,0,8,0" />
                <ui:Button Content="{loc:Tr Disguise.ApplyAll}"
                           Icon="{ui:SymbolIcon HatGraduation24}"
                           Appearance="Primary"
                           Command="{Binding DisguiseAllCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>

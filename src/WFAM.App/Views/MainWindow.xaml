<ui:FluentWindow x:Class="WFAM.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:pages="clr-namespace:WFAM.App.Views.Pages"
                 xmlns:loc="clr-namespace:WFAM.App.Helpers"
                 mc:Ignorable="d"
                 Title="{loc:Tr App.Title}"
                 Width="1425" Height="895"
                 MinWidth="900" MinHeight="600"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{loc:Tr App.Title}"
                     ShowMaximize="True">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="FolderLink24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- 警告横幅：当前进程以管理员身份运行 -->
        <Border Grid.Row="1"
                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10"
                Visibility="{Binding ShowAdminWarning, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Grid.Column="0"
                               Symbol="ShieldError24"
                               FontSize="22"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <ui:TextBlock Text="{loc:Tr Admin.Warning.Title}"
                                  FontTypography="BodyStrong"
                                  Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                    <ui:TextBlock Text="{loc:Tr Admin.Warning.Subtitle}"
                                  FontTypography="Caption"
                                  TextWrapping="Wrap"
                                  MaxWidth="1100" />
                </StackPanel>
                <ui:Button Grid.Column="2"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon Dismiss24}"
                           ToolTip="{loc:Tr Admin.Warning.Dismiss}"
                           Command="{Binding DismissAdminWarningCommand}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <ui:NavigationView x:Name="RootNavigation"
                               PaneDisplayMode="Left"
                               OpenPaneLength="220"
                               IsBackButtonVisible="Collapsed"
                               IsPaneToggleVisible="True">

                <ui:NavigationView.Header>
                    <ui:BreadcrumbBar Margin="42,18,0,0" FontSize="22" />
                </ui:NavigationView.Header>

                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem Content="{loc:Tr Nav.Folders}"
                                           TargetPageType="{x:Type pages:FoldersPage}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Folder24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="{loc:Tr Nav.Drives}"
                                           TargetPageType="{x:Type pages:UsbDrivesPage}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="UsbStick24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="{loc:Tr Nav.History}"
                                           TargetPageType="{x:Type pages:HistoryPage}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="History24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                </ui:NavigationView.MenuItems>

                <ui:NavigationView.FooterMenuItems>
                    <ui:NavigationViewItem Content="{loc:Tr Nav.Settings}"
                                           TargetPageType="{x:Type pages:SettingsPage}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Settings24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                </ui:NavigationView.FooterMenuItems>
            </ui:NavigationView>

            <ui:SnackbarPresenter x:Name="SnackbarPresenter"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Bottom"
                                  Margin="0,0,24,24" />

            <ui:ContentDialogHost x:Name="DialogHost" />
        </Grid>
    </Grid>
</ui:FluentWindow>
